# --- Claude (you pay Anthropic directly; no credit system) ---
ANTHROPIC_API_KEY=
# Default model for every run. Jobs can override with `model:` in config/org.yaml.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# --- Composio (tool access to 1000+ apps) ---
COMPOSIO_API_KEY=

# --- Slack (Socket Mode: no public URL needed) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- Email channel (optional) ---
# Port for the inbound-email webhook (point Postmark / Mailgun / Cloudflare Email Workers here).
EMAIL_WEBHOOK_PORT=8787
# Shared secret the inbound provider must send as ?token=... or X-Webhook-Token.
EMAIL_WEBHOOK_TOKEN=

# Which org config to load and where to keep memory/state.
ORG_CONFIG=config/org.yaml
DATA_DIR=data
