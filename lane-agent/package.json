{
  "name": "lane-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI growth & marketing employee for Slack + email, built on the Claude Agent SDK and Composio.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "job": "tsx src/cli.ts job",
    "ask": "tsx src/cli.ts ask",
    "connect": "tsx src/cli.ts connect",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@composio/core": "^0.28.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.3.0",
    "node-cron": "^4.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
